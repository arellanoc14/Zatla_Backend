PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# The site's address, for the /view/<token> links in share emails (required
# for email; on Render: https://zatla2-frontend.onrender.com)
PUBLIC_URL=http://localhost:5174
# Postgres: shares, orders, QuickBooks connection (db.js)
DATABASE_URL=
# Share emails and order confirmations (resend.js)
RESEND_API_KEY=
RESEND_FROM=
# Checkout (orders.js). Stripe webhook, on this API's host:
#   https://zatla2-backend.onrender.com/api/orders/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# QuickBooks Sales Receipt sync (quickbooks.js). Redirect URI, on this API's host:
#   https://zatla2-backend.onrender.com/api/quickbooks/callback
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_USE_SANDBOX=
QB_CONNECT_TOKEN=
QB_ITEM_NAME=
